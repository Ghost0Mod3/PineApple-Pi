[Unit]
Description=PineApple-Pi Complete Dashboard
After=network-online.target NetworkManager.service avahi-daemon.service
Wants=network-online.target
[Service]
User=ghost0mod3
Group=ghost0mod3
WorkingDirectory=/opt/pineapple-pi
EnvironmentFile=/opt/pineapple-pi/.env
ExecStart=/opt/pineapple-pi/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/pineapple-pi/database /opt/pineapple-pi/data /opt/pineapple-pi/logs
[Install]
WantedBy=multi-user.target
